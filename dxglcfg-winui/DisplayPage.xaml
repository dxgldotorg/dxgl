<Page
    x:Class="dxglcfg_winui.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:dxglcfg_winui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="DisplayPageGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="PageHeader"
            Margin="36,24,36,0"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Display" />
        <ScrollView
            Grid.Row="1"
            Padding="36,0,36,0"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <Border>
                <StackPanel Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <RepositionThemeTransition />
                    </StackPanel.ChildrenTransitions>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Basic settings" />
                    <local:SettingsExpanderControl
                        Description="Chooses how to handle video mode changes"
                        Header="Video mode">
                        <!--PanelIndex="{x:Bind dxglcfg_scaler.SelectedIndex, Mode=OneWay}">-->
                        <local:SettingsExpanderControl.HeaderContent>
                            <ComboBox Name="dxglcfg_scaler">
                                <ComboBoxItem Content="Change desktop resolution" Tag="x:{Int32 0}" />
                                <ComboBoxItem Content="Stretch to screen" Tag="x:{Int32 1}" />
                                <ComboBoxItem Content="Aspect corrected stretch" Tag="x:{Int32 2}" />
                                <ComboBoxItem Content="Center image on screen" Tag="x:{Int32 3}" />
                                <ComboBoxItem Content="Stretch if mode not found" Tag="x:{Int32 4}" />
                                <ComboBoxItem Content="Scale if mode not found" Tag="x:{Int32 5}" />
                                <ComboBoxItem Content="Center if mode not found" Tag="x:{Int32 6}" />
                                <ComboBoxItem Content="Crop to screen" Tag="x:{Int32 7}" />
                                <ComboBoxItem Content="Custom size multiplier" Tag="x:{Int32 8}" />
                                <ComboBoxItem Content="Custom display mode" Tag="x:{Int32 9}" />
                                <ComboBoxItem Content="Custom size, centered" Tag="x:{Int32 10}" />
                            </ComboBox>
                        </local:SettingsExpanderControl.HeaderContent>
                        <!--<local:SettingsExpanderControl.Panels>
                            <Grid
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <ComboBox Header="Test" SelectedIndex="0">
                                    <ComboBoxItem>item 1</ComboBoxItem>
                                    <ComboBoxItem>item 2</ComboBoxItem>
                                    <ComboBoxItem>item 3</ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </local:SettingsExpanderControl.Panels>-->
                    </local:SettingsExpanderControl>
                    <local:SettingsCardControl Description="Add support for various color depths.  8, 16, and 32 are recommended." Header="Add color depths">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Name="dxglcfg_AddColorDepths_8" Content="8-bit" />
                                <CheckBox Name="dxglcfg_AddColorDepths_16" Content="16-bit" />
                                <CheckBox Name="dxglcfg_AddColorDepths_32" Content="32-bit" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Name="dxglcfg_AddColorDepths_15" Content="15-bit" />
                                <CheckBox Name="dxglcfg_AddColorDepths_24" Content="24-bit" />
                                <Button Name="dxglcfg_AddColorDepths_reset" Content="Reset" />
                            </StackPanel>
                        </StackPanel>
                    </local:SettingsCardControl>
                    <local:SettingsCardControl Description="Select the filter to use for scaling the output" Header="Scaling method">
                        <ComboBox Name="dxglcfg_scalingfilter">
                            <ComboBoxItem Content="Nearest" Tag="x:Int32 0" />
                            <ComboBoxItem Content="Bilinear" Tag="x:Int32 1" />
                        </ComboBox>
                    </local:SettingsCardControl>
                </StackPanel>
            </Border>
        </ScrollView>
    </Grid>
</Page>
