<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid x:Name="DisplayPageGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="PageHeader"
            Margin="36,24,36,0"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Display" />
        <ScrollView
            Grid.Row="1"
            Padding="36,0,36,0"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <Border>
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                    <StackPanel.ChildrenTransitions>
                        <RepositionThemeTransition />
                    </StackPanel.ChildrenTransitions>
                    <TextBlock Style="{StaticResource DisplayPageSectionHeaderStyle}" Text="Basic settings" />
                    <!--<controls:SettingsCard Description="Chooses how to handle video mode changes" Header="Video mode">-->
                    <ComboBox Name="dxglcfg-fullmode">
                        <ComboBoxItem Content="Change desktop resolution" Tag="x:Int32 0}" />
                        <ComboBoxItem Content="Stretch to screen" Tag="x:Int32 1}" />
                        <ComboBoxItem Content="Aspect corrected stretch" Tag="x:Int32 2}" />
                        <ComboBoxItem Content="Center image on screen" Tag="x:Int32 3}" />
                        <ComboBoxItem Content="Stretch if mode not found" Tag="x:Int32 4}" />
                        <ComboBoxItem Content="Scale if mode not found" Tag="x:Int32 5}" />
                        <ComboBoxItem Content="Center if mode not found" Tag="x:Int32 6}" />
                        <ComboBoxItem Content="Crop to screen" Tag="x:Int32 7}" />
                        <ComboBoxItem Content="Custom size multiplier" Tag="x:Int32 8}" />
                        <ComboBoxItem Content="Custom display mode" Tag="x:Int32 9}" />
                        <ComboBoxItem Content="Custom size, centered" Tag="x:Int32 10}" />
                    </ComboBox>
                    <!--</controls:SettingsCard>-->
                </StackPanel>
            </Border>
        </ScrollView>
    </Grid>
</Page>
